# Where the app reads its data. static = JSON files (public demo), api = FastAPI.
VITE_DATA_MODE=static
# Base URL of scan.json, instances.json, issues.json (static mode).
VITE_DATA_BASE_URL=/data
# FastAPI base URL (api mode). The dev server proxies /api to http://127.0.0.1:8000.
VITE_API_BASE_URL=/api
# Base URL of the Potree tiles (folder that holds metadata.json).
VITE_TILES_BASE_URL=/data/potree/nora
