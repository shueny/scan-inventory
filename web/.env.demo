# Settings for the public demo build: `pnpm --dir web build:demo` (ADR 0015).
# No secrets here: everything in a Vite build is public.
VITE_DATA_MODE=static
# The demo's JSON and tiles come from the private R2 bucket through the Pages Function at
# /r2/<key>; "v1" is the data version (docs/DEPLOY.md, scripts/deploy/upload_demo_data.sh).
VITE_DATA_BASE_URL=/r2/v1/data
VITE_TILES_BASE_URL=/r2/v1/potree/nora
# Review changes in the browser are kept per data version; a new version starts clean.
VITE_DATA_VERSION=v1
VITE_REPO_URL=https://github.com/shueny/scan-inventory
# Set when the demo video is uploaded (docs/DEPLOY.md, step 7); empty: no video link.
VITE_DEMO_VIDEO_URL=
